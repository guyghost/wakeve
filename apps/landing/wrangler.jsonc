{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wakeve-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-06-14",
  "assets": {
    "directory": "./.svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "wakeve.app/*",
      "zone_name": "wakeve.app"
    }
  ],
  "vars": {
    "APPLE_TEAM_ID": ""
  }
}
